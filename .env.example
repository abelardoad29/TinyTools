# Copy to .env.local and fill in once you have an approved AdSense account with a live
# domain (Fase C). Both are public client identifiers, not secrets. Leaving these unset
# disables the ad banner entirely (AdBanner renders nothing) — safe default.
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_ID=

# Only needed for the Tauri desktop build (Fase D), once the web app is deployed —
# the desktop app has no server of its own to relatively-path fetch. Leave unset for
# the web build itself; it correctly uses the same-origin relative path.
VITE_VERIFY_ENDPOINT=
